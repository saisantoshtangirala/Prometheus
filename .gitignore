__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so
# Credentials. `.env` alone matches ONLY a file named exactly that - a
# file called kite.env or .env.prod would sail straight past it.
.env
*.env
.env.*
!.env.example
kite.env
*_secret*
*.secret
# Secret-bearing files only. NOT source.
#
# This line used to read `*totp*`, which also matched
# nightevolver/totp.py and tests/test_totp.py - so `git add -A` silently
# skipped them and a commit claiming "28 TOTP tests" shipped neither the
# module nor the tests. The box then failed with a ModuleNotFoundError
# for a file that plainly existed in the working tree.
totp.secret
totp_secret*
*.totp
*credentials*
kite_auth.env
.venv
/env/
/venv/
/output/
/checkpoints/
/data/cache/
/data/scenarios/
*.pt
*.pkl
*.log
.DS_Store
*.html
notebooks/.ipynb_checkpoints/
/logs/
/KILL_SWITCH

# Cached NSE source data (bhavcopy zips, participant CSVs, corp actions).
# Re-fetchable and large; the loaders rebuild it on demand.
/data/cache/

# Recorded market depth. Large, append-only, and irreplaceable - back it
# up off the box, but do not commit it.
/data/depth/

# Published project documents are deliverables, not build output - the
# blanket *.html rule above would silently drop them.
!docs/*.html

# SAFETY NET. A secret-matching pattern above must never swallow source
# code. This class of mistake is silent - `git add -A` skips the file and
# the commit succeeds - so it is worth an explicit un-ignore rather than
# care. Secrets belong in files without a source extension.
!**/*.py
!**/*.yml
!**/*.yaml
